SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<SECRET_2d7e0d68>vroject-anon-key
SUPABASE_JWT_SECRET=dev-secret-change-me
STRIPE_SECRET_KEY=sk_test_<SECRET_cc4b8adf>IPE_PUBLISHABLE_KEY=pk_test_...
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed CORS origins. If unset: dev ENV allows
# localhost:3000 only, non-dev ENV allows https://astral.app only.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override where branches.py reads tradition markdown from
# (defaults to <repo>/raw/astrology).
# ASTRO_RAW_DIR=

# Optional: override where the /v1/memory proxy looks for Hermes Agent's
# local memory store (defaults to D:\AI\AOS\hermes). HERMES_STATE_DB
# defaults to <HERMES_MEMORY_ROOT>\state.db.
# HERMES_MEMORY_ROOT=
# HERMES_STATE_DB=

# ── AI หมอดู (เลือกอย่างใดอย่างหนึ่ง) ──────────────────────────
# ไม่ตั้งอะไรเลย = rule-based fallback (ตอบจาก keywords, ไม่ต้องพึ่ง AI)
#
# วิธี 1: Groq (ฟรี, เร็วมาก, 30 req/min, Llama 3.3 70B)
#   สมัครที่ console.groq.com → สร้าง API key → ใส่ด้านล่าง
# GROQ_API_KEY=gsk_xxxxx
# GROQ_MODEL=llama-3.3-70b-versatile
#
# วิธี 2: OpenRouter (ฟรี ถ้าใช้ model:free)
#   สมัครที่ openrouter.ai → สร้าง API key → ใส่ด้านล่าง
# OPENROUTER_API_KEY=sk-or-xxxxx
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# วิธี 3: ใช้ AI ของตัวเอง (OpenAI, OpenRouter แบบเสียเงิน, etc.)
# ASTRAL_LLM_API_KEY=sk-xxxxx
# ASTRAL_LLM_BASE_URL=https://api.openai.com/v1
# ASTRAL_LLM_MODEL=gpt-4o-mini
